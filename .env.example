# ============================================
# Cheese Expo 2027 Environment Variables
# ============================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cheese_expo_2027

# Payment Services Configuration

# Яндекс.Касса (YooKassa)
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=your_secret_key_here
YOOKASSA_WEBHOOK_SECRET=webhook_secret

# Сбербанк
SBERBANK_MERCHANT_LOGIN=your_login
SBERBANK_MERCHANT_PASSWORD=your_password
SBERBANK_TEST_MODE=true

# CloudPayments
CLOUDPAYMENTS_PUBLIC_ID=your_public_id
CLOUDPAYMENTS_API_SECRET=your_api_secret

# Email Configuration
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@cheeseexpo.pro

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Auth (if using Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_key
CLERK_SECRET_KEY=your_secret

# Analytics
NEXT_PUBLIC_GA_ID=UA-XXXXXXX-X

# Company Info (для счетов и платежей)
COMPANY_NAME=ООО Cheese Expo
COMPANY_INN=7123456789
COMPANY_KPP=123456789
COMPANY_BANK_ACCOUNT=40702810000000000001
COMPANY_BANK_BIK=044525000
COMPANY_BANK_NAME=ПАО Сбербанк
